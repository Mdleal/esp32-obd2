# /etc/chip-logger.env  -- config for the CHIP OBD2 logger.
# Point MQTT_HOST and INFLUX_URL at your HOME LAN IPs (reachable over the WireGuard tunnel).

VEHICLE=mycar

# OBD (Veepeak over Bluetooth rfcomm)
OBD_PORT=/dev/rfcomm0
OBD_BAUD=38400

# InfluxDB 2.x (home LAN IP over the tunnel)
INFLUX_URL=http://192.168.1.10:8086
INFLUX_ORG=your-org
INFLUX_BUCKET=obd2-ram
INFLUX_TOKEN=paste-influx-write-token-here

# MQTT broker / Home Assistant (home LAN IP over the tunnel)
MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=

# Reuse the ESP32's HA identity so the existing dashboard + "Car" tracker keep working.
# Change these if you want the CHIP to appear as a separate device.
# (Quote values with spaces so the systemd EnvironmentFile / shell test both parse them.)
HA_DEVICE_ID=esp32logger
HA_DEVICE_NAME="OBD2 Logger"

BUFFER_FILE=/var/lib/chip-logger/buffer.lp
